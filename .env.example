# ============================================================
#  Job Sniper — environment configuration
#  Copy to `.env` and fill in.  NEVER commit .env to git.
#  Verify any change with:  python main.py --check-llm
# ============================================================

# ---------- Discord ----------
# Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXXXX/YYYYYYYYYYYYYYYYYYYY

# ============================================================
#  LLM — set to Gemini for a completely FREE setup
# ============================================================
# One of: gemini | openrouter | groq | openai | custom | none
LLM_PROVIDER=gemini

# The provider-specific variable BELOW wins over LLM_API_KEY, so a leftover
# generic key can never be sent to the wrong endpoint.
#
# GEMINI (free tier, no credit card):  https://aistudio.google.com/apikey
#   Keys start with "AIza". Free of charge unless YOU link a billing account to
#   the project — a key on a project without billing cannot cost you money.
GEMINI_API_KEY=

# Other providers, only needed if you switch LLM_PROVIDER:
#   OPENROUTER_API_KEY=sk-or-v1-...   https://openrouter.ai/keys
#   GROQ_API_KEY=gsk_...              https://console.groq.com/keys
#   OPENAI_API_KEY=sk-proj-...        https://platform.openai.com/api-keys

# Generic fallback key. LEAVE EMPTY for Gemini — if it holds a key from another
# provider, --check-llm warns you and requests would fail against Google.
LLM_API_KEY=

# Optional overrides (leave blank to use the provider preset).
# Gemini free-tier model names change over time; if the default is retired,
# `--check-llm` lists every model your key can call — put one of those here.
LLM_BASE_URL=
LLM_MODEL=
VISION_MODEL=

# ============================================================
#  EMAIL alerts (optional — same matches as Discord, sent by Gmail SMTP)
# ============================================================
# Free, stdlib only. Gmail requires an APP PASSWORD (not your account password)
# with 2-step verification enabled: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=raeesahmed7280@gmail.com
SMTP_PASSWORD=
# Where alerts go (defaults to SMTP_USER when blank).
EMAIL_TO=raeesahmed7280@gmail.com
# Optional: read the app password from a file instead of the variable above.
SMTP_PASSWORD_FILE=

# ---------- Behaviour ----------
# Extra request delay (seconds) between portal hits — be a good citizen.
SCRAPE_DELAY_SECONDS=1.5
REQUEST_TIMEOUT=45
# Playwright: headless true for cron/VPS, false to watch it work.
HEADLESS=true
# Hard cap on LLM calls per run, enforced inside the evaluator. A normal run
# needs 5-25 calls; free tiers are rate-limited per minute and per day, so keep
# this modest. 0 = unlimited (NOT recommended on a free tier).
MAX_LLM_CALLS_PER_RUN=25
# Reasoning models need a long window: a 7k-char advertisement plus the rules
# prompt can take 1-2 minutes. Too short a window silently downgrades to the
# regex heuristic.
LLM_TIMEOUT_SECONDS=180
# Push regex-heuristic matches (used when the LLM is unavailable/budget spent)
# to Discord? false = only LLM-verified matches alert you (recommended).
NOTIFY_ON_HEURISTIC=false
# Only notify for jobs posted within N days (0 = no limit).
MAX_JOB_AGE_DAYS=30
# Re-notify the same job after N days (0 = never repeat).
RESCAN_AFTER_DAYS=0

# ---------- OCR / long advertisements ----------
# Path to the tesseract binary if not on PATH. Empty = auto-detect.
TESSERACT_CMD=
# Consolidated ads are 20+ page scans. Pages are OCR'd in chunks and each chunk
# is one LLM call, so raise/lower these to trade coverage against API cost.
MAX_PDF_PAGES=12
PDF_PAGE_CHUNK=3
PDF_RENDER_DPI=200
OCR_TIMEOUT_SECONDS=60
# Vision (image) calls carry a whole scanned page and are much slower.
VISION_TIMEOUT_SECONDS=240
# Longest image edge sent to the vision model; smaller = faster.
VISION_MAX_EDGE=1600

# ---------- Files ----------
STATE_FILE=state/seen_jobs.json
LOG_DIR=logs
LOG_LEVEL=INFO
